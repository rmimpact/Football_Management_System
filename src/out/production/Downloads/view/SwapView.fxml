<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<?import javafx.scene.control.Separator?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<VBox alignment="CENTER" styleClass="background"
      prefWidth="540.0"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SwapController">


    <ImageView fitWidth="540" fitHeight="300">
        <Image url="/view/image/banner.png"/>
    </ImageView>

    <VBox alignment="CENTER" prefWidth="540" spacing="10">
        <Separator/>
        <Label text="Swap Team" styleClass="heading"/>
        <Separator/>
        <ListView fx:id="teamListView" prefWidth="540"/>
        <HBox>
            <Button fx:id="swapButton" styleClass="button" prefWidth="270" HBox.hgrow="ALWAYS" text="Swap"
                    disable="true" onAction="#handleTeamSwap"/>
            <Button fx:id="closeButton" styleClass="button" prefWidth="270" HBox.hgrow="ALWAYS" text="Close"
                    onAction="#handleClose"/>
        </HBox>
    </VBox>

    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
</VBox>
