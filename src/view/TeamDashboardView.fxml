<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Label?>
<?import java.net.URL?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" styleClass="background"
      prefWidth="540.0"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.TeamDashboardController">

    <ImageView fitWidth="540" fitHeight="300">
        <Image url="/view/image/banner.png"/>
    </ImageView>

    <VBox alignment="CENTER" prefWidth="540.0" spacing="10">
        <Separator/>
        <Label fx:id="teamLabel" text="You should not see this" styleClass="heading"/>
        <Separator/>

        <HBox alignment="CENTER" spacing="10">
            <Label text="Sign a new player:" styleClass="label"/>
            <TextField fx:id="playerSearchTextField" disable="false" onKeyReleased="#handleKeyRelease" onAction="#handlePlayerSign"/>
            <Button fx:id="signPlayerButton" text="Sign" styleClass="button" prefWidth="60" disable="true" onAction="#handlePlayerSign"/>
        </HBox>

        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="60"/>
                <ColumnConstraints percentWidth="40"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints percentHeight="100"/>
            </rowConstraints>

            <VBox>
                <padding>
                    <Insets left="10" bottom="10" right="0"/>
                </padding>

            <TableView fx:id="playerTable"
                       GridPane.columnIndex="0"
                       GridPane.hgrow="ALWAYS"
                       GridPane.vgrow="ALWAYS"
                       editable="false"
                       styleClass="teamTableView"
                        >
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="playerNameColumn" text="Name" resizable="false"/>
                    <TableColumn fx:id="playerPositionColumn" text="Position" resizable="false"/>
                </columns>
            </TableView>
            </VBox>

            <VBox GridPane.columnIndex="1" spacing="0" alignment="TOP_CENTER">
                <padding>
                    <Insets right="10" bottom="10"/>
                </padding>
                <HBox styleClass="activeTeamHeader" alignment="CENTER">
                <Label text="Active Team" styleClass="activeTeamHeader" textAlignment="CENTER" alignment="TOP_CENTER"/>
                </HBox>

                <VBox styleClass="activeTeamVBox"
                      VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="70" left="10"/>
                    </padding>
                <GridPane fx:id="shirtGrid" hgap="5" vgap="10" alignment="CENTER" prefWidth="-Infinity" styleClass="activeTeamVBox">
                    <padding>
                        <Insets top="0" bottom="20"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints prefWidth="50"/>
                        <ColumnConstraints prefWidth="50"/>
                        <ColumnConstraints prefWidth="50"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="50"/>
                        <RowConstraints prefHeight="50"/>
                        <RowConstraints prefHeight="50"/>
                    </rowConstraints>

                    <ImageView fx:id="topMidPlayerImage"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"
                               fitWidth="40" preserveRatio="true"
                               styleClass="imageview-shirt"
                               pickOnBounds="true"
                               onMouseClicked="#handleTopMidPlayerClick">
                        <Image url="/view/image/none.png"/>
                    </ImageView>

                    <ImageView fx:id="midLeftPlayerImage"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"
                               fitWidth="40" preserveRatio="true"
                               styleClass="imageview-shirt"
                               pickOnBounds="true"
                               onMouseClicked="#handleMidLeftPlayerClick">
                        <Image url="/view/image/none.png"/>
                    </ImageView>
                    <ImageView fx:id="midMidPlayerImage"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"
                               fitWidth="40" preserveRatio="true"
                               styleClass="imageview-shirt"
                               pickOnBounds="true"
                               onMouseClicked="#handleMidMidPlayerImageClick">
                        <Image url="/view/image/none.png"/>
                    </ImageView>
                    <ImageView fx:id="midRightPlayerImage"
                               GridPane.rowIndex="1" GridPane.columnIndex="2"
                               fitWidth="40" preserveRatio="true"
                               styleClass="imageview-shirt"
                               pickOnBounds="true"
                               onMouseClicked="#handleMidRightPlayerImageClick">
                        <Image url="/view/image/none.png"/>
                    </ImageView>

                    <ImageView fx:id="botMidPlayerImage"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"
                               fitWidth="40" preserveRatio="true"
                               styleClass="imageview-shirt"
                               pickOnBounds="true"
                               onMouseClicked="#handleBotMidPlayerImageClick">
                        <Image url="/view/image/none.png"/>
                    </ImageView>
                </GridPane>
                </VBox>
            </VBox>
        </GridPane>
    </VBox>

    <HBox>
        <Button fx:id="unsignPlayerButton" styleClass="button" prefWidth="270" HBox.hgrow="ALWAYS" text="Unsign" onAction="#handlePlayerUnsign" disable="true"/>
        <Button styleClass="button" prefWidth="270" HBox.hgrow="ALWAYS" text="Close" onAction="#handleClose"/>
    </HBox>

    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>

</VBox>